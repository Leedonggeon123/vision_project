<UserControl x:Class="VisionInspector.Views.LiveInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 머리말 + 오늘 건수 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="오늘" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Border Background="#143D24" CornerRadius="14" Padding="14,4" Margin="0,0,8,0">
                    <TextBlock Foreground="{StaticResource OkBrush}" FontWeight="SemiBold">
                        <Run Text="OK "/><Run Text="{Binding TodayOk, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
                <Border Background="#4A1D1D" CornerRadius="14" Padding="14,4">
                    <TextBlock Foreground="{StaticResource NgBrush}" FontWeight="SemiBold">
                        <Run Text="NG "/><Run Text="{Binding TodayNg, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
            </StackPanel>
            <TextBlock Text="실시간 검사" Style="{StaticResource PageTitle}"/>
        </DockPanel>

        <!-- 원본 | 히트맵 | 결과·조작 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="원본 / 웹캠" Style="{StaticResource CardTitle}"/>
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                        <TextBlock Style="{StaticResource EmptyHint}" Text="웹캠을 켜거나 사진을 선택하세요"
                                   Visibility="{Binding PreviewImage, Converter={StaticResource NullToVis}, ConverterParameter=inv}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="히트맵 (파랑=정상, 빨강=이상)" Style="{StaticResource CardTitle}"/>
                    <Image Source="{Binding HeatmapPath, Converter={StaticResource PathToImage}}" Stretch="Uniform"/>
                </DockPanel>
            </Border>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 판정 -->
                <Border Grid.Row="0" CornerRadius="12" Padding="16" Background="{Binding ResultBrush}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ResultText}" FontSize="58" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 점수 -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="이상 점수" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScoreText}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="기준값 (이상이면 NG)" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ThresholdText}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Text="검사 시간" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ElapsedText}" Margin="0,6,0,0"/>
                    </Grid>
                </Border>

                <!-- 조작 -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button AutomationProperties.AutomationId="BtnCamera" Content="{Binding CameraButtonText}" Command="{Binding ToggleCameraCommand}"
                            Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsFolderRunning, Converter={StaticResource InverseBool}}"/>
                    <Button AutomationProperties.AutomationId="BtnAuto" Content="{Binding AutoButtonText}" Command="{Binding ToggleAutoCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" IsEnabled="{Binding IsEngineReady}"/>
                    <Button AutomationProperties.AutomationId="BtnInspectNow" Content="지금 1장 검사" Command="{Binding InspectNowCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" IsEnabled="{Binding IsEngineReady}"/>
                    <Button AutomationProperties.AutomationId="BtnPickFile" Content="파일 선택해서 검사" Command="{Binding PickFileCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" IsEnabled="{Binding IsEngineReady}"/>
                    <Button AutomationProperties.AutomationId="BtnFolder" Content="{Binding FolderButtonText}" Command="{Binding ToggleFolderRunCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" IsEnabled="{Binding IsEngineReady}"/>
                </StackPanel>

                <!-- 최근 결과 -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="최근 검사" Style="{StaticResource CardTitle}" Margin="4,0,0,6"/>
                        <ListBox ItemsSource="{Binding Recent}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Result}" FontWeight="Bold" Margin="10,0,0,0"
                                                   Foreground="{Binding Result, Converter={StaticResource ResultToBrush}}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat=F3}" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 안내 메시지 -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                   Margin="2,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
