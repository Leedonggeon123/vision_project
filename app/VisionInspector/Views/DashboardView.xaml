<UserControl x:Class="VisionInspector.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                      DisplayMemberPath="Label" Width="140" VerticalAlignment="Center"/>
            <TextBlock Text="통계 대시보드" Style="{StaticResource PageTitle}"/>
        </DockPanel>

        <!-- 숫자 카드 -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,14">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="전체 검사" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding TotalText}" FontSize="30" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="OK" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding OkText}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="NG" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding NgText}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource NgBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="불량률" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding NgRateText}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="평균 검사 시간" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding AvgMsText}" FontSize="30" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 도넛 + 날짜별 막대 -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.6*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="OK / NG 비율" Style="{StaticResource CardTitle}"/>
                    <lvc:PieChart Series="{Binding PieSeries}" LegendPosition="Bottom" LegendTextPaint="{Binding LegendPaint}"
                                  Background="Transparent"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="날짜별 검사 건수" Style="{StaticResource CardTitle}"/>
                    <lvc:CartesianChart Series="{Binding DailySeries}" XAxes="{Binding DailyXAxes}" YAxes="{Binding DailyYAxes}"
                                        LegendPosition="Bottom" LegendTextPaint="{Binding LegendPaint}"
                                        Background="Transparent"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 최근 점수 추이 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="최근 50건 점수 추이 (점선 = 기준값)" Style="{StaticResource CardTitle}"/>
                <lvc:CartesianChart Series="{Binding ScoreSeries}" XAxes="{Binding ScoreXAxes}" YAxes="{Binding ScoreYAxes}"
                                    LegendPosition="Bottom" LegendTextPaint="{Binding LegendPaint}"
                                    Background="Transparent"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
