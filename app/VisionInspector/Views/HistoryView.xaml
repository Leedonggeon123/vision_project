<UserControl x:Class="VisionInspector.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 표 머리글 / 칸 글자 모양 -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="이력 조회" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>

        <!-- 조회 조건 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="판정" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding ResultOptions}" SelectedItem="{Binding ResultFilter}" Width="90"/>
                    <TextBlock Text="기간" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="22,0,8,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="140"/>
                    <TextBlock Text="~" VerticalAlignment="Center" Margin="8,0"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="140"/>
                    <Button Content="조회" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="22,0,0,0" Width="90"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- 목록 (머리글 + 줄 목록) -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="6">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,8,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="시간" Style="{StaticResource HeaderText}"/>
                        <TextBlock Grid.Column="1" Text="판정" Style="{StaticResource HeaderText}"/>
                        <TextBlock Grid.Column="2" Text="점수" Style="{StaticResource HeaderText}"/>
                        <TextBlock Grid.Column="3" Text="기준값" Style="{StaticResource HeaderText}"/>
                        <TextBlock Grid.Column="4" Text="시간(ms)" Style="{StaticResource HeaderText}"/>
                        <TextBlock Grid.Column="5" Text="출처" Style="{StaticResource HeaderText}"/>
                        <TextBlock Grid.Column="6" Text="파일" Style="{StaticResource HeaderText}"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,0,0,4"/>

                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#27272A"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3A3322"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource CellText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Result}" FontWeight="Bold" Style="{StaticResource CellText}"
                                               Foreground="{Binding Result, Converter={StaticResource ResultToBrush}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat=F3}" Style="{StaticResource CellText}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Threshold, StringFormat=F2}" Style="{StaticResource CellText}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding ElapsedMs}" Style="{StaticResource CellText}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding SourceText}" Style="{StaticResource CellText}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding ImageFileName}" Style="{StaticResource CellText}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 선택한 검사의 원본 / 히트맵 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="원본" Style="{StaticResource CardTitle}"/>
                    <Image Grid.Row="1" Stretch="Uniform"
                           Source="{Binding Selected.ImagePath, Converter={StaticResource PathToImage}}"/>
                    <TextBlock Grid.Row="2" Text="히트맵" Style="{StaticResource CardTitle}" Margin="0,12,0,10"/>
                    <Image Grid.Row="3" Stretch="Uniform"
                           Source="{Binding Selected.HeatmapPath, Converter={StaticResource PathToImage}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
