<Window x:Class="VisionInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VisionInspector.ViewModels"
        xmlns:views="clr-namespace:VisionInspector.Views"
        Title="제조 현장 AI 비전 검사" Width="1380" Height="840" MinWidth="1180" MinHeight="720"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 뷰모델 → 화면 연결 -->
        <DataTemplate DataType="{x:Type vm:LiveInspectionViewModel}"><views:LiveInspectionView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측 메뉴 -->
            <Border Grid.Column="0" Background="{StaticResource NavBrush}">
                <DockPanel Margin="12,24,12,12">
                    <StackPanel DockPanel.Dock="Top" Margin="8,0,8,24">
                        <TextBlock Text="AI 비전 검사" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="금속 너트 이상탐지" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                             Background="Transparent" BorderThickness="0">
                        <!-- 메뉴 항목 모양: 선택되면 주황 막대 + 약간 밝은 배경 -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="0,2">
                                                <Grid>
                                                    <Border x:Name="Bar" Width="4" CornerRadius="2" Background="{StaticResource AccentBrush}"
                                                            HorizontalAlignment="Left" Margin="0,10" Visibility="Collapsed"/>
                                                    <ContentPresenter Margin="10,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#222225"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2B2B2F"/>
                                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="6,10">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 우측 내용 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
        </Grid>

        <!-- 아래 상태 표시줄: 엔진 상태 -->
        <Border Grid.Row="1" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="{Binding EngineStatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding EngineStatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
